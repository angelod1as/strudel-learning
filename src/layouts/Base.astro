---
import '../styles/global.css';
import { CHAPTERS, REFERENCE, SITE_TITLE, withBase } from '../consts';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A hands-on tour of Strudel: syntax, sound design, and the mixer.' } =
  Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '');
const parts: { part: string; items: typeof CHAPTERS }[] = [];
for (const chapter of CHAPTERS) {
  const last = parts[parts.length - 1];
  if (last && last.part === chapter.part) last.items.push(chapter);
  else parts.push({ part: chapter.part, items: [chapter] });
}
const numberOf = (slug: string) => CHAPTERS.findIndex((c) => c.slug === slug) + 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE_TITLE}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script src="https://unpkg.com/@strudel/repl@1.3.0"></script>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href={withBase('/')}>{SITE_TITLE}</a>
        <div class="brand-sub">an interactive Strudel tutorial</div>
        <div class="nav-progress" data-progress-ui hidden>
          <div class="progress-bar" aria-hidden="true">
            <span data-progress-fill></span>
          </div>
          <div class="nav-progress-text">
            <span class="count" data-progress-count>0 / 0</span> chapters done
          </div>
        </div>
        {
          parts.map((group) => (
            <>
              <div class="nav-part">{group.part}</div>
              {group.items.map((chapter) => (
                <a
                  class="nav-link"
                  href={withBase(`/tutorial/${chapter.slug}`)}
                  data-progress-slug={chapter.slug}
                  data-progress-title={chapter.title}
                  aria-current={path === withBase(`/tutorial/${chapter.slug}`) ? 'page' : undefined}
                >
                  <span class="nav-num">{String(numberOf(chapter.slug)).padStart(2, '0')}</span>
                  <span>{chapter.title}</span>
                  <span class="progress-mark">
                    <span class="sr-only">completed</span>✓
                  </span>
                </a>
              ))}
            </>
          ))
        }
        <div class="nav-part">Reference</div>
        {
          REFERENCE.map((ref) => (
            <a
              class="nav-link"
              href={withBase(`/reference/${ref.slug}`)}
              aria-current={path === withBase(`/reference/${ref.slug}`) ? 'page' : undefined}
            >
              <span class="nav-num">·</span>
              <span>{ref.title}</span>
            </a>
          ))
        }
      </aside>
      <main>
        <slot />
      </main>
    </div>
    <script is:inline>
      // Lesson progress. Inline and synchronous on purpose: it runs while the
      // document is still being parsed, so completed chapters are already
      // marked at first paint instead of flashing in a moment later.
      (function () {
        var KEY = 'strudel-tutorial:progress';

        // Storage throws in private mode and in some embedded browsers. Probe
        // once; if it is unusable the progress UI simply never appears.
        var store = null;
        try {
          var probe = KEY + ':probe';
          window.localStorage.setItem(probe, '1');
          window.localStorage.removeItem(probe);
          store = window.localStorage;
        } catch (e) {
          store = null;
        }

        var read = function () {
          if (!store) return [];
          try {
            var parsed = JSON.parse(store.getItem(KEY) || '{}');
            var list = parsed && parsed.completed;
            if (!Array.isArray(list)) return [];
            return list.filter(function (slug) {
              return typeof slug === 'string' && slug !== '';
            });
          } catch (e) {
            return [];
          }
        };

        var write = function () {
          if (!store) return;
          try {
            store.setItem(KEY, JSON.stringify({ v: 1, completed: done }));
          } catch (e) {}
        };

        var done = read();
        var isDone = function (slug) {
          return done.indexOf(slug) !== -1;
        };

        var chapterLinks = [].slice.call(
          document.querySelectorAll('.sidebar [data-progress-slug]')
        );

        var apply = function () {
          document.querySelectorAll('[data-progress-slug]').forEach(function (el) {
            var on = isDone(el.getAttribute('data-progress-slug'));
            if (on) el.setAttribute('data-progress-done', '');
            else el.removeAttribute('data-progress-done');
            if (el.hasAttribute('aria-pressed')) {
              el.setAttribute('aria-pressed', on ? 'true' : 'false');
            }
          });

          // The sidebar lists every chapter, so it is the source of truth for
          // both the total and the order.
          var total = chapterLinks.length;
          var count = 0;
          var upNext = null;
          chapterLinks.forEach(function (link) {
            if (isDone(link.getAttribute('data-progress-slug'))) count++;
            else if (!upNext) upNext = link;
          });

          document.querySelectorAll('[data-progress-count]').forEach(function (el) {
            el.textContent = count + ' / ' + total;
          });
          document.querySelectorAll('[data-progress-fill]').forEach(function (el) {
            el.style.width = total ? Math.round((count / total) * 100) + '%' : '0%';
          });

          var cont = document.querySelector('[data-progress-continue]');
          var allDone = document.querySelector('[data-progress-alldone]');
          if (cont) {
            if (upNext) {
              cont.href = upNext.href;
              var label = cont.querySelector('[data-progress-continue-label]');
              var title = cont.querySelector('[data-progress-continue-title]');
              if (label) label.textContent = count ? 'Continue with' : 'Start with';
              if (title) title.textContent = upNext.getAttribute('data-progress-title') || '';
            }
            cont.hidden = !upNext;
          }
          if (allDone) allDone.hidden = !!upNext || !chapterLinks.length;
        };

        var mark = function (slug, on) {
          if (!slug) return;
          var at = done.indexOf(slug);
          if (on && at === -1) done.push(slug);
          else if (!on && at !== -1) done.splice(at, 1);
          else return;
          write();
          apply();
        };

        // Manual tick / untick on a chapter page.
        var toggle = document.querySelector('[data-progress-toggle]');
        if (toggle) {
          toggle.addEventListener('click', function () {
            var slug = toggle.getAttribute('data-progress-slug');
            mark(slug, !isDone(slug));
          });
        }

        // Following "next" counts as having finished the current chapter. The
        // write is synchronous, so it lands before the navigation.
        var nextLink = document.querySelector('[data-progress-complete]');
        if (nextLink) {
          nextLink.addEventListener('click', function () {
            mark(nextLink.getAttribute('data-progress-complete'), true);
          });
        }

        var reset = document.querySelector('[data-progress-reset]');
        if (reset) {
          reset.addEventListener('click', function () {
            if (!done.length) return;
            if (!window.confirm('Clear your progress? This cannot be undone.')) return;
            done = [];
            write();
            apply();
          });
        }

        // Another tab may have changed things, and a page restored from the
        // back/forward cache keeps whatever it painted last time.
        window.addEventListener('storage', function (e) {
          if (e.key !== null && e.key !== KEY) return;
          done = read();
          apply();
        });
        window.addEventListener('pageshow', function (e) {
          if (!e.persisted) return;
          done = read();
          apply();
        });

        apply();
        if (store) {
          document.querySelectorAll('[data-progress-ui]').forEach(function (el) {
            el.hidden = false;
          });
        }
      })();
    </script>
    <script>
      // Listeners only. These are safe to attach before the unpkg bundle has
      // defined the custom element, because `el.editor` is read lazily.
      const wireButtons = () => {
        document.querySelectorAll('.strudel').forEach((box) => {
          const el = box.querySelector('strudel-editor');
          const btn = box.querySelector('.strudel-play');
          if (!el || !btn || btn.dataset.wired) return;
          btn.dataset.wired = '1';
          btn.addEventListener('click', () => el.editor?.toggle());
          el.addEventListener('update', (e) => {
            const started = e.detail?.started;
            btn.textContent = started ? '■ stop' : '▶ play';
            btn.classList.toggle('is-playing', !!started);
          });
        });
      };

      // Anything that touches `el.editor` has to wait for the element to be
      // upgraded, and must not share a guard flag with the listeners above.
      const configureEditors = () => {
        document.querySelectorAll('strudel-editor').forEach((el) => {
          if (!el.editor || el.dataset.configured) return;
          el.dataset.configured = '1';
          // long chains are common in the examples — wrap instead of scrolling
          try {
            el.editor.setLineWrappingEnabled(true);
          } catch {}
        });
      };

      wireButtons();
      customElements.whenDefined('strudel-editor').then(() => {
        wireButtons();
        configureEditors();
      });
    </script>
  </body>
</html>

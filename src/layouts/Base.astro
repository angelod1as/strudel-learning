---
import '../styles/global.css';
import { CHAPTERS, REFERENCE, SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A hands-on tour of Strudel: syntax, sound design, and the mixer.' } =
  Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '');
const parts: { part: string; items: typeof CHAPTERS }[] = [];
for (const chapter of CHAPTERS) {
  const last = parts[parts.length - 1];
  if (last && last.part === chapter.part) last.items.push(chapter);
  else parts.push({ part: chapter.part, items: [chapter] });
}
const numberOf = (slug: string) => CHAPTERS.findIndex((c) => c.slug === slug) + 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE_TITLE}</title>
    <meta name="description" content={description} />
    <script src="https://unpkg.com/@strudel/repl@1.3.0"></script>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/">{SITE_TITLE}</a>
        <div class="brand-sub">an interactive Strudel tutorial</div>
        {
          parts.map((group) => (
            <>
              <div class="nav-part">{group.part}</div>
              {group.items.map((chapter) => (
                <a
                  class="nav-link"
                  href={`/tutorial/${chapter.slug}`}
                  aria-current={path === `/tutorial/${chapter.slug}` ? 'page' : undefined}
                >
                  <span class="nav-num">{String(numberOf(chapter.slug)).padStart(2, '0')}</span>
                  <span>{chapter.title}</span>
                </a>
              ))}
            </>
          ))
        }
        <div class="nav-part">Reference</div>
        {
          REFERENCE.map((ref) => (
            <a
              class="nav-link"
              href={`/reference/${ref.slug}`}
              aria-current={path === `/reference/${ref.slug}` ? 'page' : undefined}
            >
              <span class="nav-num">·</span>
              <span>{ref.title}</span>
            </a>
          ))
        }
      </aside>
      <main>
        <slot />
      </main>
    </div>
    <script>
      // Wire up the play/stop button of each embedded REPL. The web component
      // exposes its StrudelMirror instance as `.editor`, but only once the
      // unpkg bundle has defined the custom element.
      const wire = () => {
        document.querySelectorAll('.strudel').forEach((box) => {
          const el = box.querySelector('strudel-editor');
          const btn = box.querySelector('.strudel-play');
          if (!el || !btn || btn.dataset.wired) return;
          btn.dataset.wired = '1';
          btn.addEventListener('click', () => el.editor?.toggle());
          // long chains are common in the examples — wrap instead of scrolling
          try {
            el.editor?.setLineWrappingEnabled(true);
          } catch {}
          el.addEventListener('update', (e) => {
            const started = e.detail?.started;
            btn.textContent = started ? '■ stop' : '▶ play';
            btn.classList.toggle('is-playing', !!started);
          });
        });
      };
      customElements.whenDefined('strudel-editor').then(wire);
      wire();
    </script>
  </body>
</html>

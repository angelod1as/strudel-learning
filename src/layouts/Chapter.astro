---
import Base from './Base.astro';
import { CHAPTERS, withBase } from '../consts';

interface Props {
  frontmatter: {
    slug: string;
    title?: string;
    lede?: string;
  };
}

const { frontmatter } = Astro.props;
const slug: string = frontmatter.slug;
const index = CHAPTERS.findIndex((c) => c.slug === slug);
const chapter = CHAPTERS[index];
const prev = index > 0 ? CHAPTERS[index - 1] : undefined;
const next = index >= 0 && index < CHAPTERS.length - 1 ? CHAPTERS[index + 1] : undefined;
const title: string = frontmatter.title ?? chapter?.title ?? 'Strudel';
---

<Base title={title} description={frontmatter.lede ?? chapter?.blurb}>
  {
    chapter && (
      <p class="eyebrow">
        {chapter.part} · Chapter {String(index + 1).padStart(2, '0')}
      </p>
    )
  }
  <h1>{title}</h1>
  {frontmatter.lede && <p class="lede">{frontmatter.lede}</p>}
  <slot />
  {
    chapter && (
      <div class="chapter-done">
        <button
          type="button"
          class="progress-toggle"
          data-progress-toggle
          data-progress-slug={slug}
          data-progress-ui
          aria-pressed="false"
          hidden
        >
          <span class="progress-box" aria-hidden="true"></span>
          <span class="t-todo">Mark as complete</span>
          <span class="t-done">Completed</span>
        </button>
      </div>
    )
  }
  <nav class="pager">
    {
      prev ? (
        <a href={withBase(`/tutorial/${prev.slug}`)}>
          <span class="dir">← previous</span>
          {prev.title}
        </a>
      ) : (
        <a href={withBase('/')}>
          <span class="dir">←</span>
          Home
        </a>
      )
    }
    {
      next && (
        <a
          class="next"
          href={withBase(`/tutorial/${next.slug}`)}
          data-progress-complete={chapter ? slug : undefined}
        >
          <span class="dir">next →</span>
          {next.title}
        </a>
      )
    }
  </nav>
</Base>
